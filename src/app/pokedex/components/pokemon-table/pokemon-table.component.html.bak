<div class="kanto-pokedex-frame">
  
  <!-- Main 3-Column Screen Content -->
  <div class="pokedex-screen-body">
    
    <!-- Leftmost Column: Sort & Filter Panel -->
    <div class="sidebar-screen">
      <div class="sidebar-header">
        <span class="sidebar-title">Filters</span>
      </div>
      <div class="sidebar-content">
        <div class="form-group">
          <label>Search PokÃƒÂ©mon</label>
          <input type="text" placeholder="Name or ID..." [value]="state().searchQuery" (input)="onSearch($event)">
        </div>
        
        <div class="form-group">
          <label>Type Filter</label>
          <select [value]="state().selectedType || ''" (change)="onTypeChange($event)">
            <option value="">All Types</option>
            @for(t of pokemonTypes; track t) {
              <option [value]="t">{{ t | uppercase }}</option>
            }
          </select>
        </div>

        <div class="form-group">
          <label>Sort By</label>
          <select [value]="state().sortBy" (change)="onSortChange($event)">
            <option value="id">ID #</option>
            <option value="name">Name</option>
          </select>
        </div>

        <div class="form-group">
          <label>Order</label>
          <select [value]="state().sortOrder" (change)="onOrderChange($event)">
            <option value="asc">Ascending</option>
            <option value="desc">Descending</option>
          </select>
        </div>
      </div>
    </div>
    
    <!-- Main Right Content Wrapper -->
    <div class="main-content-area">
      <!-- Moved Kanto Header -->
      <div class="main-screens-header">
        <span class="header-title">Kanto PokÃƒÂ©dex</span>
      </div>

      <div class="screens-container">
        <!-- Left Screen: Display 2D Sprite Preview & PokÃƒÂ©dex Entry Description -->
        <div class="left-screen">
      <div class="preview-header">
        <span class="preview-name">
          {{ (activePokemon?.name || '---') | uppercase }}
        </span>
      </div>

      <div class="display-box">
        <div class="grid-background"></div>
        <div class="pokeball-bg"></div>
        
        @if (state().isLoading) {
          <img 
            [src]="getGlitchSpriteUrl()" 
            alt="Loading..." 
            class="pokemon-sprite-2d shimmer-sprite"
          >
        } @else if (state().error) {
          <div class="error-placeholder" style="color: red; font-family: 'Courier New', monospace; font-size: 24px; text-align: center; margin-top: 60px; font-weight: bold;">
            ERROR_
          </div>
        } @else {
          @if (activePokemon) {
            <!-- Type Badges Overlay -->
            @if (activePokemon.types) {
              <div class="type-badges">
                @for (type of activePokemon.types; track type) {
                  <span class="type-badge" [attr.data-type]="type">{{ type | uppercase }}</span>
                }
              </div>
            }

            <img 
              [src]="get2dSpriteUrl(activePokemon.id)" 
              [alt]="activePokemon.name" 
              class="pokemon-sprite-2d"
            >
          } @else {
            <div class="no-pokemon">---</div>
          }
        }
      </div>

      <!-- Description Box with Manual View Base Stats Button -->
      <div class="description-box">
        <div class="desc-header">
          <span class="desc-title">Entry Details</span>
          @if (activePokemon) {
            <button class="retro-btn-stats" (click)="openStatsModal(activePokemon, $event)">
              BASE STATS Radar Ã¢Ëœâ€¦
            </button>
          }
        </div>
        <div class="desc-text">
          {{ getPokemonDescription(activePokemon?.name || '') }}
        </div>
      </div>
    </div>

    <!-- Right Screen: Scrollable Pokemon List -->
    <div class="right-screen">
      <div class="red-side-stripe"></div>
      
      <div class="list-container">
        <!-- LOADING STATE, EMPTY STATE, SUCCESS STATE -->
        @if (state().isLoading) {
          <div class="skeleton-container">
            @for (i of skeletonRows; track $index) {
              <div class="skeleton-row shimmer">
                <div class="sk-badge"></div>
                <div class="sk-num"></div>
                <div class="sk-name"></div>
              </div>
            }
          </div>
        } @else if (state().error) {
          <div class="empty-state error-state" style="text-align: center; padding: 20px;">
            <p style="color: #ff5555; margin-bottom: 10px;">{{ state().error }}</p>
            <button class="retro-btn-stats" (click)="retryLoad()" style="background: #333; color: white;">
              RETRY CONNECTION
            </button>
          </div>
        } @else if (pokemonList().length === 0) {
          <div class="empty-state">
            <p>No PokÃƒÂ©mon found</p>
          </div>
        } @else {
          <cdk-virtual-scroll-viewport 
            itemSize="96" 
            minBufferPx="200" 
            maxBufferPx="400" 
            class="pokedex-virtual-viewport"
            #listContainer
            cdkDropList
            [cdkDropListConnectedTo]="['dock-slot-0', 'dock-slot-1', 'dock-slot-2', 'dock-slot-3', 'dock-slot-4', 'dock-slot-5']"
            [cdkDropListSortingDisabled]="true"
          >
            <div 
              *cdkVirtualFor="let pokemon of pokemonList(); trackBy: trackById" 
              class="list-row"
              [class.selected]="activePokemon?.id === pokemon.id"
              (click)="selectPokemon(pokemon)"
              cdkDrag
              [cdkDragData]="pokemon"
            >
              <div *cdkDragPreview class="drag-preview-sprite">
                <img [src]="get2dSpriteUrl(pokemon.id)" width="60" height="60" style="filter: drop-shadow(2px 4px 6px rgba(0,0,0,0.5));">
              </div>

              <span class="num">{{ pokemon.id.toString().padStart(3, '0') }}</span>
              
              <span class="icon-sprite-box">
                <img [src]="get2dSpriteUrl(pokemon.id)" class="mini-icon" [alt]="pokemon.name">
              </span>
              
              <span class="name">{{ pokemon.name | uppercase }}</span>
            </div>
          </cdk-virtual-scroll-viewport>
        }
      </div>
    </div>
  </div> <!-- closes screens-container -->
  </div> <!-- closes main-content-area -->
  </div> <!-- closes pokedex-screen-body -->

  <!-- Red Footer -->
  <div class="pokedex-footer">
    <app-team-dock
      [selectedTeamName]="teamName()"
      [allTeamNames]="allTeamNames()"
      [teamPokemon]="dockedTeam()" [teamTotalBaseStats]="teamTotalBaseStats()"
      (removePokemon)="removePokemon($event)"
      (dropPokemon)="onDropPokemon($event)"
      (openSearch)="openSearchModal($event)"
      (openTeamList)="openTeamListModal()"
      (openRenameModal)="openRenameTeamModal()"
      (createTeam)="openCreateTeamModal()"
      (nextTeam)="onNextTeam()"
      (prevTeam)="onPrevTeam()">
    </app-team-dock>
  </div>
</div> <!-- closes kanto-pokedex-frame -->

@if (activeModal() !== null) {
  <div class="generic-modal-backdrop" (click)="closeModal()">
    <div class="generic-modal-content" (click)="$event.stopPropagation()">
      <button class="close-btn" (click)="closeModal()">X</button>
      
      @if (activeModal() === 'createTeam' || activeModal() === 'renameTeam') {
        <h2 style="margin-top: 0;">{{ activeModal() === 'createTeam' ? 'Create New Team' : 'Rename Team' }}</h2>
        <input type="text" [value]="modalInput()" (input)="modalInput.set($any($event).target.value)" placeholder="Enter team name..." class="modal-text-input" (keydown.enter)="submitModalInput()" />
        <button class="retro-btn-save" (click)="submitModalInput()" style="margin-top: 16px; width: 100%;">{{ activeModal() === 'createTeam' ? 'CREATE' : 'RENAME' }}</button>
      }

      @if (activeModal() === 'teamList') {
        <h2 style="margin-top: 0;">Select a Team</h2>
        <div class="modal-list">
          @for (name of allTeamNames(); track name) {
            <div class="modal-list-item" (click)="selectTeamFromModal(name)" [class.selected]="name === teamName()">
              {{ name }}
            </div>
          }
        </div>
      }

      @if (activeModal() === 'search') {
        <h2 style="margin-top: 0;">Find PokÃ©mon</h2>
        <input type="text" [value]="modalSearchQuery()" (input)="modalSearchQuery.set($any($event).target.value)" placeholder="Name or ID..." class="modal-text-input" />
        <div class="modal-list scrollable">
          @for (p of modalFilteredPokemon(); track p.id) {
            <div class="modal-list-item search-item" (click)="selectPokemonForSlot(p)">
              <img [src]="get2dSpriteUrl(p.id)" width="40" height="40" />
              <span>#{{ p.id.toString().padStart(3, '0') }} {{ p.name | uppercase }}</span>
            </div>
          }
        </div>
      }
    </div>
  </div>
}

<!-- Base Stats Animated Radar Chart Modal -->
<app-pokemon-detail></app-pokemon-detail>


